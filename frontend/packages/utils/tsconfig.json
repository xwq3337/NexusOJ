{
  "extends": "@nexusoj/typescript/index.json",
  "compilerOptions": {
    "composite": true,
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo.json",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
