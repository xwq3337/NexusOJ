{
  "name": "nexusoj-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build-only" : "turbo build-only",
    "preview": "turbo preview",
    "lint": "turbo lint",
    "format": "turbo format",
    "upload" : "turbo upload",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "dev:client": "pnpm --filter @nexusoj/client dev",
    "dev:admin": "pnpm --filter @nexusoj/admin dev",
    "build:client": "pnpm --filter @nexusoj/client build",
    "build:admin": "pnpm --filter @nexusoj/admin build"
  },
  "devDependencies": {
    "turbo": "^2.4.2",
    "prettier": "^3.4.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
